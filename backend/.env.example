# =============================================================================
# CoinTrack Backend — Environment Variables
# =============================================================================
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Docker / Render, set these as container environment variables instead.
# =============================================================================

# ── App Configuration ─────────────────────────────────────────────────────────
PROJECT_NAME="CoinTrack API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="change-me-to-a-long-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get your connection string from https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Blockchain ────────────────────────────────────────────────────────────────
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# ── Hugging Face (AI features) ────────────────────────────────────────────────
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase (authentication) ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Privy (embedded wallets for email/password users) ─────────────────────────
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.aicointrack.xyz
