# Backend Environment Variables Template
# Copy this file to .env and fill in with your actual values
# NEVER commit .env to version control!

PROJECT_NAME="CoinTrack API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
# Generate a strong secret key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# MySQL Database
# Local development defaults
MYSQL_USER=root
MYSQL_PASSWORD=7459
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_DB=cointrack_db
# Or use DATABASE_URL directly: mysql+pymysql://user:password@host:port/database
DATABASE_URL="mysql+pymysql://root:7459@localhost:3306/cointrack_db"

# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com

# 1. Project ID (REQUIRED)
# Settings > General > Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# 2. Service Account Key Path (OPTIONAL)
# Download from: Settings > Service Accounts > Generate New Private Key
# Store the file as 'serviceAccountKey.json' in backend root
# Set this to the path if you downloaded a key, otherwise leave empty
FIREBASE_CREDENTIALS_PATH=

# 3. API Key (OPTIONAL)
# Settings > General > Web API Key
FIREBASE_API_KEY=your-firebase-api-key

# 4. Database URL (OPTIONAL)
# For Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# 5. Storage Bucket (OPTIONAL)
# For Firebase Cloud Storage
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# External Services
# Base RPC URL for blockchain operations
BASE_RPC_URL=https://mainnet.base.org

# HuggingFace API Key for AI features
HF_API_KEY=your_huggingface_key
